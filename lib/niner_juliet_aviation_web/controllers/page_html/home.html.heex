<!-- Hero Section -->
<section class="relative h-screen flex items-center justify-center overflow-hidden">
  <video autoplay muted loop class="absolute top-0 left-0 w-full h-full object-cover -z-10">
    <source src="https://assets.mixkit.co/videos/preview/mixkit-airplane-flying-in-a-blue-sky-1584-large.mp4" type="video/mp4">
  </video>
  <div class="absolute inset-0 bg-gradient-to-br from-blue-900/80 via-gray-600/70 to-gray-300/60"></div>
  
  <div class="relative z-10 px-4 text-center max-w-4xl mx-auto">
    <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Delivering Aviation Excellence in Zambia</h1>
    <p class="text-xl md:text-2xl text-gray-100 mb-8">Premium aviation services including FBO, technical construction, and engineering consultancy at Kenneth Kaunda International Airport.</p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <button class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-md text-lg font-medium transition duration-300 transform hover:scale-105">Request Service</button>
      <button class="bg-transparent hover:bg-white hover:text-blue-800 text-white border-2 border-white px-6 py-3 rounded-md text-lg font-medium transition duration-300 transform hover:scale-105">Explore Fleet</button>
    </div>
  </div>
</section>

<!-- About Section -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">About Niner Juliet Aviation</h2>
      <div class="mt-4 h-1 w-20 bg-blue-600 mx-auto"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <img src="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?ixlib=rb-4.0.3&auto=format&fit=crop&w=1474&q=80" alt="Hangar" class="rounded-lg shadow-xl w-full h-auto">
      </div>
      
      <div>
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Our Story</h3>
        <p class="text-gray-600 mb-6">Founded in Zambia, Niner Juliet Aviation has grown to become a trusted name in aviation services. Our team of experienced professionals is dedicated to providing top-tier solutions tailored to the unique needs of our clients.</p>
        
        <div class="mb-8">
          <h4 class="text-xl font-semibold text-gray-800 mb-2">Our Vision</h4>
          <p class="text-gray-600">To be the leading aviation service provider in Southern Africa, recognized for our commitment to safety, innovation, and customer satisfaction.</p>
        </div>
        
        <div>
          <h4 class="text-xl font-semibold text-gray-800 mb-2">Our Mission</h4>
          <p class="text-gray-600">To deliver comprehensive aviation solutions that exceed industry standards while fostering long-term partnerships with our clients through reliability and excellence.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Services Section -->
<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">Our Aviation Services</h2>
      <div class="mt-4 h-1 w-20 bg-blue-600 mx-auto"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition duration-300 hover:-translate-y-2">
        <div class="h-48 bg-blue-600 flex items-center justify-center">
          <svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2L3 7v11a1 1 0 001 1h12a1 1 0 001-1V7l-7-5z"/>
          </svg>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-2">Fixed-Base Operations (FBO)</h3>
          <p class="text-gray-600 mb-4">Premium services for private and commercial aircraft including fueling, hangaring, and passenger amenities.</p>
          <button class="text-blue-600 hover:text-blue-800 font-medium">Request Quote →</button>
        </div>
      </div>
      
      <div class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition duration-300 hover:-translate-y-2">
        <div class="h-48 bg-blue-700 flex items-center justify-center">
          <svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"/>
          </svg>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-2">Technical Construction</h3>
          <p class="text-gray-600 mb-4">Specialized construction services for hangars, runways, and aviation infrastructure projects.</p>
          <button class="text-blue-600 hover:text-blue-800 font-medium">Request Quote →</button>
        </div>
      </div>
      
      <div class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition duration-300 hover:-translate-y-2">
        <div class="h-48 bg-blue-800 flex items-center justify-center">
          <svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-2">Charter Flights</h3>
          <p class="text-gray-600 mb-4">Reliable and comfortable charter services for business and leisure travel throughout the region.</p>
          <button class="text-blue-600 hover:text-blue-800 font-medium">Request Quote →</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">Contact Us</h2>
      <div class="mt-4 h-1 w-20 bg-blue-600 mx-auto"></div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <h3 class="text-2xl font-bold text-gray-800 mb-6">Send Us a Message</h3>
        <form class="space-y-6">
          <input type="text" placeholder="Full Name" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500">
          <input type="email" placeholder="Email Address" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500">
          <textarea rows="5" placeholder="Message" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"></textarea>
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-md font-medium transition duration-300">Send Message</button>
        </form>
      </div>
      
      <div>
        <h3 class="text-2xl font-bold text-gray-800 mb-6">Contact Information</h3>
        <div class="bg-gray-50 rounded-lg p-6">
          <div class="mb-6">
            <h4 class="text-lg font-semibold text-gray-800">Location</h4>
            <p class="text-gray-600">Kenneth Kaunda International Airport, Lusaka, Zambia</p>
          </div>
          <div class="mb-6">
            <h4 class="text-lg font-semibold text-gray-800">Phone</h4>
            <p class="text-gray-600">+260 96 5291772</p>
          </div>
          <div>
            <h4 class="text-lg font-semibold text-gray-800">Email</h4>
            <p class="text-gray-600">robert@ninerjuliet.com</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-gray-900 text-white pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <div>
        <img src={~p"/images/logo.svg"} alt="Niner Juliet Logo" class="h-10 mb-4">
        <p class="text-gray-400 mb-4">Delivering aviation excellence in Zambia with premium services and unmatched expertise.</p>
      </div>
      
      <div>
        <h3 class="text-lg font-semibold mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-gray-400 hover:text-white transition duration-300">Home</a></li>
          <li><a href="#about" class="text-gray-400 hover:text-white transition duration-300">About Us</a></li>
          <li><a href="#services" class="text-gray-400 hover:text-white transition duration-300">Services</a></li>
          <li><a href="#contact" class="text-gray-400 hover:text-white transition duration-300">Contact</a></li>
        </ul>
      </div>
      
      <div>
        <h3 class="text-lg font-semibold mb-4">Services</h3>
        <ul class="space-y-2">
          <li><a href="#" class="text-gray-400 hover:text-white transition duration-300">FBO Services</a></li>
          <li><a href="#" class="text-gray-400 hover:text-white transition duration-300">Technical Construction</a></li>
          <li><a href="#" class="text-gray-400 hover:text-white transition duration-300">Charter Flights</a></li>
        </ul>
      </div>
      
      <div>
        <h3 class="text-lg font-semibold mb-4">Contact Info</h3>
        <div class="space-y-2 text-gray-400">
          <p>Kenneth Kaunda International Airport</p>
          <p>Lusaka, Zambia</p>
          <p>+260 96 5291772</p>
          <p>robert@ninerjuliet.com</p>
        </div>
      </div>
    </div>
    
    <div class="border-t border-gray-800 mt-12 pt-8 text-center">
      <p class="text-gray-400 text-sm">© 2023 Niner Juliet Aviation. All rights reserved.</p>
    </div>
  </div>
</footer>