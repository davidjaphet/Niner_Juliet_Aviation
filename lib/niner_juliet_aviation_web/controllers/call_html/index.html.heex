<%# Hero %>
<div class="contact-hero-bg min-h-[35vh] flex items-center justify-center text-white relative">
  <div class="absolute inset-0 bg-black/60"></div>
  <div class="relative z-10 text-center px-4">
    <h1 class="text-3xl sm:text-4xl md:text-6xl font-bold mb-3 hero-title">Call Us</h1>
    <p class="text-white/70 text-base hero-subtitle">We're available 24/7 — reach us on any of the numbers below</p>
  </div>
</div>

<%# Call Cards %>
<section class="py-20 bg-gray-50 reveal-section">
  <div class="container mx-auto px-4 max-w-3xl">
    <div class="space-y-6">

      <%# Main Office %>
      <div class="bg-white rounded-2xl shadow-md p-5 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center shrink-0">
            <i class="fas fa-phone-alt text-white text-xl"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm text-gray-500 mb-0.5">Main Office</p>
            <p class="text-xl font-bold text-gray-800" id="num1">+260 965 291 772</p>
            <p class="text-xs text-gray-400 mt-0.5">General enquiries & bookings</p>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-4">
          <a href="tel:+260965291772"
            class="flex items-center justify-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white px-3 py-3 rounded-xl text-sm font-semibold transition">
            <i class="fas fa-phone text-xs"></i> Call
          </a>
          <a href="https://wa.me/260965291772" target="_blank"
            class="flex items-center justify-center gap-1.5 bg-green-500 hover:bg-green-600 text-white px-3 py-3 rounded-xl text-sm font-semibold transition">
            <i class="fab fa-whatsapp"></i> Chat
          </a>
          <button onclick="copyNumber('num1', this)"
            class="flex items-center justify-center gap-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-3 rounded-xl text-sm font-semibold transition">
            <i class="fas fa-copy text-xs"></i> Copy
          </button>
        </div>
      </div>

      <%# 24/7 Operations %>
      <div class="bg-white rounded-2xl shadow-md p-5 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 bg-green-500 rounded-full flex items-center justify-center shrink-0">
            <i class="fas fa-headset text-white text-xl"></i>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm text-gray-500 mb-0.5">24/7 Operations Line</p>
            <p class="text-xl font-bold text-gray-800" id="num2">+260 977 123 456</p>
            <p class="text-xs text-gray-400 mt-0.5">Urgent cargo & flight operations</p>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-4">
          <a href="tel:+260977123456"
            class="flex items-center justify-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white px-3 py-3 rounded-xl text-sm font-semibold transition">
            <i class="fas fa-phone text-xs"></i> Call
          </a>
          <a href="https://wa.me/260977123456" target="_blank"
            class="flex items-center justify-center gap-1.5 bg-green-500 hover:bg-green-600 text-white px-3 py-3 rounded-xl text-sm font-semibold transition">
            <i class="fab fa-whatsapp"></i> Chat
          </a>
          <button onclick="copyNumber('num2', this)"
            class="flex items-center justify-center gap-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-3 rounded-xl text-sm font-semibold transition">
            <i class="fas fa-copy text-xs"></i> Copy
          </button>
        </div>
      </div>

      <%# Email %>
      <a href="mailto:robert@ninerjuliet.com"
        class="group flex items-center gap-6 bg-white rounded-2xl shadow-md p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        <div class="w-16 h-16 bg-blue-100 group-hover:bg-blue-600 rounded-full flex items-center justify-center shrink-0 transition-colors duration-300">
          <i class="fas fa-envelope text-blue-600 group-hover:text-white text-2xl transition-colors duration-300"></i>
        </div>
        <div class="flex-1">
          <p class="text-sm text-gray-500 mb-1">Prefer email?</p>
          <p class="text-xl font-bold text-gray-800">robert@ninerjuliet.com</p>
          <p class="text-xs text-gray-400 mt-1">We reply within 1 business hour</p>
        </div>
        <div class="bg-blue-50 group-hover:bg-blue-600 text-blue-600 group-hover:text-white px-4 py-2 rounded-full text-sm font-semibold transition-all duration-300 shrink-0">
          Email Us
        </div>
      </a>

    </div>

    <%# Visit Us %>
    <div class="mt-12 bg-blue-700 rounded-2xl p-8 text-white text-center">
      <i class="fas fa-map-marker-alt text-3xl mb-4 block text-blue-300"></i>
      <h3 class="text-xl font-bold mb-2">Visit Us</h3>
      <p class="text-blue-200">Private Hangars, Kenneth Kaunda International Airport, Lusaka, Zambia</p>
      <a href="https://maps.google.com/?q=Kenneth+Kaunda+International+Airport+Lusaka+Zambia" target="_blank"
        class="inline-flex items-center gap-2 mt-4 bg-white text-blue-700 font-semibold px-6 py-2 rounded-full hover:bg-blue-50 transition hover:scale-105">
        <i class="fas fa-directions"></i> Get Directions
      </a>
    </div>

  </div>
</section>

<script>
  function copyNumber(id, btn) {
    const text = document.getElementById(id).textContent.trim();
    navigator.clipboard.writeText(text).then(() => {
      const original = btn.innerHTML;
      btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
      btn.classList.add('bg-green-100', 'text-green-700');
      setTimeout(() => {
        btn.innerHTML = original;
        btn.classList.remove('bg-green-100', 'text-green-700');
      }, 2000);
    });
  }
</script>
