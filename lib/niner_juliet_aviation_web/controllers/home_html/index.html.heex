<%# Hero Section %>
<div class="hero-bg min-h-screen flex items-center justify-center text-white relative overflow-hidden">
  <div class="container mx-auto px-4 text-center relative z-10">
    <div class="hero-badge inline-flex items-center bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 mb-6 text-sm font-medium">
      <span class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></span>
      Now operating Pan-African routes
    </div>
    <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold mb-4 hero-title">
      Aviation <span class="text-blue-400">Made Simple</span>
    </h1>
    <p class="text-base sm:text-xl md:text-2xl mb-8 max-w-3xl mx-auto text-white/80 hero-subtitle px-2">
      Zambia's premier aviation logistics company providing reliable cargo, charter, and technical services from Kenneth Kaunda International Airport.
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-3 hero-cta px-4">
      <a href="/contact" class="group bg-blue-600 hover:bg-blue-500 text-white px-6 py-4 rounded-full text-base font-semibold transition-all duration-300 flex items-center justify-center gap-2">
        <i class="fas fa-paper-plane"></i> Request a Service
      </a>
      <a href="/services" class="group bg-white/10 backdrop-blur-sm border-2 border-white/50 hover:bg-white hover:text-gray-900 text-white px-6 py-4 rounded-full text-base font-semibold transition-all duration-300 flex items-center justify-center gap-2">
        <i class="fas fa-th-large"></i> Our Services
      </a>
    </div>
  </div>
  <a href="#stats" class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/60 hover:text-white transition animate-bounce">
    <i class="fas fa-chevron-down text-2xl"></i>
  </a>
</div>

<%# Animated Stats Bar %>
<section id="stats" class="bg-blue-700 py-10">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center text-white">
      <div class="stat-item py-2">
        <div class="text-3xl font-bold mb-1"><span class="counter" data-target="25">0</span>+</div>
        <p class="text-blue-200 text-xs uppercase tracking-wide">Years Experience</p>
      </div>
      <div class="stat-item py-2">
        <div class="text-3xl font-bold mb-1"><span class="counter" data-target="500">0</span>+</div>
        <p class="text-blue-200 text-xs uppercase tracking-wide">Flights Completed</p>
      </div>
      <div class="stat-item py-2">
        <div class="text-3xl font-bold mb-1"><span class="counter" data-target="18">0</span></div>
        <p class="text-blue-200 text-xs uppercase tracking-wide">African Countries</p>
      </div>
      <div class="stat-item py-2">
        <div class="text-3xl font-bold mb-1"><span class="counter" data-target="99">0</span>%</div>
        <p class="text-blue-200 text-xs uppercase tracking-wide">On-Time Rate</p>
      </div>
    </div>
  </div>
</section>

<%# Interactive Services Preview %>
<section class="py-20 bg-gray-50 reveal-section">
  <div class="container mx-auto px-4">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">What We Do</h2>
      <div class="w-20 h-1 bg-blue-600 mx-auto"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <div class="service-card group bg-white rounded-2xl shadow-md overflow-hidden cursor-pointer transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
        <div class="h-48 bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center relative overflow-hidden">
          <div class="absolute inset-0 bg-blue-900 opacity-0 group-hover:opacity-20 transition-opacity duration-300"></div>
          <i class="fas fa-box-open text-white text-6xl group-hover:scale-110 transition-transform duration-300"></i>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-3">Air Cargo Services</h3>
          <p class="text-gray-500 mb-5 text-sm">Safe, timely international cargo logistics with customs clearance support for all freight types.</p>
          <a href="/services" class="inline-flex items-center gap-2 text-blue-600 font-semibold hover:gap-3 transition-all duration-200">
            Learn more <i class="fas fa-arrow-right text-sm"></i>
          </a>
        </div>
      </div>

      <div class="service-card group bg-white rounded-2xl shadow-md overflow-hidden cursor-pointer transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
        <div class="h-48 bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center relative overflow-hidden">
          <div class="absolute inset-0 bg-blue-900 opacity-0 group-hover:opacity-20 transition-opacity duration-300"></div>
          <i class="fas fa-plane text-white text-6xl group-hover:scale-110 group-hover:rotate-12 transition-transform duration-300"></i>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-3">Charter Flights</h3>
          <p class="text-gray-500 mb-5 text-sm">Private and business transport with flexible scheduling, direct routing and personalized service.</p>
          <a href="/services" class="inline-flex items-center gap-2 text-blue-600 font-semibold hover:gap-3 transition-all duration-200">
            Learn more <i class="fas fa-arrow-right text-sm"></i>
          </a>
        </div>
      </div>

      <div class="service-card group bg-white rounded-2xl shadow-md overflow-hidden cursor-pointer transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
        <div class="h-48 bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center relative overflow-hidden">
          <div class="absolute inset-0 bg-blue-900 opacity-0 group-hover:opacity-20 transition-opacity duration-300"></div>
          <i class="fas fa-tools text-white text-6xl group-hover:scale-110 transition-transform duration-300"></i>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-3">Technical Services</h3>
          <p class="text-gray-500 mb-5 text-sm">Hangar setups, maintenance facilities, and full aviation infrastructure solutions.</p>
          <a href="/services" class="inline-flex items-center gap-2 text-blue-600 font-semibold hover:gap-3 transition-all duration-200">
            Learn more <i class="fas fa-arrow-right text-sm"></i>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<%# Trust Bar %>
<section class="bg-white border-t border-gray-100 py-12 reveal-section">
  <div class="container mx-auto px-4">
    <div class="flex flex-wrap justify-center items-center gap-10 md:gap-20">
      <div class="text-center group">
        <div class="w-16 h-16 bg-blue-50 group-hover:bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-3 transition-colors duration-300">
          <i class="fas fa-shield-alt text-blue-600 group-hover:text-white text-2xl transition-colors duration-300"></i>
        </div>
        <p class="font-semibold text-gray-700">Certified by KKIA</p>
      </div>
      <div class="text-center group">
        <div class="w-16 h-16 bg-blue-50 group-hover:bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-3 transition-colors duration-300">
          <i class="fas fa-check-circle text-blue-600 group-hover:text-white text-2xl transition-colors duration-300"></i>
        </div>
        <p class="font-semibold text-gray-700">25+ Years Experience</p>
      </div>
      <div class="text-center group">
        <div class="w-16 h-16 bg-blue-50 group-hover:bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-3 transition-colors duration-300">
          <i class="fas fa-globe-africa text-blue-600 group-hover:text-white text-2xl transition-colors duration-300"></i>
        </div>
        <p class="font-semibold text-gray-700">Pan-African Network</p>
      </div>
      <div class="text-center group">
        <div class="w-16 h-16 bg-blue-50 group-hover:bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-3 transition-colors duration-300">
          <i class="fas fa-clock text-blue-600 group-hover:text-white text-2xl transition-colors duration-300"></i>
        </div>
        <p class="font-semibold text-gray-700">24/7 Support</p>
      </div>
    </div>
  </div>
</section>

<%# CTA Banner %>
<section class="bg-blue-700 py-16 reveal-section">
  <div class="container mx-auto px-4 text-center text-white">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to take off?</h2>
    <p class="text-blue-200 mb-8 text-lg">Get in touch with our team and we'll have you airborne in no time.</p>
    <a href="/contact" class="inline-flex items-center gap-2 bg-white text-blue-700 font-bold px-8 py-4 rounded-full hover:bg-blue-50 transition-all duration-300 hover:scale-105 hover:shadow-lg">
      <i class="fas fa-envelope"></i> Contact Us Today
    </a>
  </div>
</section>
